# Dossier ou seront enregistres les PDF scannes (et le fichier autoscan.log)
OUTPUT_FOLDER=C:\Users\VotreNom\Documents\Scans

# Delai d'inactivite (secondes) apres la derniere page avant de finaliser le PDF
WAIT_SECONDS=30

# Intervalle (secondes) entre deux tentatives de scan quand le bac est vide
POLL_INTERVAL=2

# Chemin vers NAPS2.Console.exe (version portable) :
# https://github.com/cyanfish/naps2/releases -> naps2-x.y.z-win-x64.zip -> App/NAPS2.Console.exe
# Si omis, valeur par defaut : <dossier du script>/NAPS2/App/NAPS2.Console.exe
NAPS2_CONSOLE=C:\Chemin\Vers\NAPS2\App\NAPS2.Console.exe

# Nom (ou partie du nom) du scanner tel qu'affiche par :
#   NAPS2.Console.exe --driver wia --listdevices
DEVICE_NAME=Brother DS-640

# Resolution de scan en DPI (300 = bon compromis qualite/poids pour l'OCR,
# 600 = qualite max supportee par le DS-640, fichiers nettement plus lourds)
DPI=300

# Mode couleur : color, gray ou bw
COLOR_MODE=color

# Qualite JPEG (0-100) des images dans le PDF final. Plus haut = moins
# d'artefacts de compression, fichiers plus lourds
JPEG_QUALITY=90

# Zone de capture maximale du scanner (pas la taille du papier -- le
# cadrage sur le papier reel se fait automatiquement via AUTO_CROP ci-dessous).
# A regler sur la taille max supportee par ton scanner, ex "8.5x14in" pour
# le DS-640. Une valeur trop petite tronquera les pages plus grandes.
PAGE_SIZE=8.5x14in

# Redresser automatiquement les pages legerement de travers (true/false)
DESKEW=true

# Recadrer automatiquement chaque page sur son contenu reel (detecte les
# bords du papier dans la zone scannee, quel que soit son format -- A4,
# Letter, ticket de caisse, etc.) au lieu de forcer un format fixe (true/false)
AUTO_CROP=true

# Seuil d'intensite de contour (0-255) au-dela duquel un pixel compte comme
# contenu (texte/logo/code-barres) plutot que fond hors-page, quelle que
# soit la luminosite de ce fond. A ajuster si le recadrage coupe trop
# (baisser) ou pas assez (augmenter)
AUTO_CROP_EDGE_THRESHOLD=60

# Marge (pixels, calibree pour 200 DPI puis mise a l'echelle automatiquement
# selon DPI) ajoutee autour de la zone de texte dense detectee, pour eviter
# de couper un logo ou un gros aplat peu texture juste a cote. Augmenter si
# un element en haut/bas/cote du document est encore coupe.
AUTO_CROP_MARGIN=20

# Corriger automatiquement l'orientation d'une page inseree a l'envers ou de
# cote (0/90/180/270), via la detection Tesseract OSD (true/false)
AUTO_ROTATE=true

# Langue(s) OCR pour le texte cherchable dans le PDF (codes a 3 lettres,
# combinables avec un "+", ex: fra+eng). Necessite d'avoir installe le pack
# correspondant avec : NAPS2.Console.exe --install ocr-fra
OCR_LANG=fra+eng

# Chemin vers tesseract.exe (utilise uniquement pour AUTO_ROTATE, distinct
# du moteur OCR interne de NAPS2). A installer via :
#   winget install -e --id UB-Mannheim.TesseractOCR
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
